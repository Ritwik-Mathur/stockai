# StockAI Environment Variables
# Copy this file to .env and add your free API keys

# Finnhub (PRIMARY - free, 60 calls/min, no CORS issues)
# Get free key at: https://finnhub.io/register
VITE_FINNHUB_KEY=your_finnhub_key_here

# Alpha Vantage (FALLBACK - free, 25 calls/day)
# Get free key at: https://www.alphavantage.co/support/#api-key
VITE_ALPHAV_KEY=your_alpha_vantage_key_here
